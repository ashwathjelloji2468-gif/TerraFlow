{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "routed_discharge.schema.json",
  "title": "M3 routed discharge artifact manifest",
  "type": "object",
  "required": ["contract_version", "site_id", "scenario_id", "source_m3_run_id", "timeseries", "time_column", "flow_column", "time_unit", "flow_unit", "routing_method", "section", "provenance", "validation_status"],
  "properties": {
    "contract_version": {"const": "0.3.0"},
    "site_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "source_m3_run_id": {"type": "string", "minLength": 1},
    "timeseries": {"const": "timeseries.csv"},
    "time_column": {"const": "t_s"},
    "flow_column": {"const": "q_m3s"},
    "time_unit": {"const": "s"},
    "flow_unit": {"const": "m3/s"},
    "routing_method": {"type": "string", "minLength": 1},
    "section": {"type": "object", "required": ["type", "coordinates", "crs"], "properties": {"type": {"const": "LineString"}, "coordinates": {"type": "array", "minItems": 2, "items": {"type": "array", "minItems": 2, "items": {"type": "number"}}}, "crs": {"type": "string"}}, "additionalProperties": true},
    "provenance": {"type": "object", "minProperties": 1},
    "validation_status": {"enum": ["artifact_schema_checked", "artifact_validated", "blocked", "failed"]}
  },
  "additionalProperties": false
}
