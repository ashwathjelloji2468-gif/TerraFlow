{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site_config.schema.json",
  "$defs": {
    "BBoxValue": {
      "additionalProperties": false,
      "description": "[min_lon, min_lat, max_lon, max_lat] in EPSG:4326 decimal degrees.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "const": "deg",
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "sourced",
            "placeholder"
          ],
          "title": "Status",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "value",
        "unit",
        "source",
        "status"
      ],
      "title": "BBoxValue",
      "type": "object"
    },
    "BreachHydrographSettings": {
      "additionalProperties": false,
      "description": "Weir coefficients and breach side slope (`backend/m2_breach/weir.py`).\n\nOptional and additive; no defaults exist in code (`docs/decisions.md`) \u2014 a `Dam` without this\nblock cannot use the `breach_growth_weir` hydrograph method.",
      "properties": {
        "weir_coefficient_rect": {
          "$ref": "#/$defs/WeirCoefficientValue"
        },
        "weir_coefficient_side": {
          "$ref": "#/$defs/WeirCoefficientValue"
        },
        "side_slope_z": {
          "$ref": "#/$defs/DimensionlessValue"
        }
      },
      "required": [
        "weir_coefficient_rect",
        "weir_coefficient_side",
        "side_slope_z"
      ],
      "title": "BreachHydrographSettings",
      "type": "object"
    },
    "BreachInputs": {
      "additionalProperties": false,
      "properties": {
        "water_volume_above_invert": {
          "$ref": "#/$defs/VolumeValue"
        },
        "water_height_above_invert": {
          "$ref": "#/$defs/LengthValue"
        },
        "breach_height": {
          "$ref": "#/$defs/LengthValue"
        },
        "dam_height": {
          "$ref": "#/$defs/LengthValue"
        },
        "average_embankment_width": {
          "$ref": "#/$defs/LengthValue"
        },
        "dam_type": {
          "$ref": "#/$defs/DamTypeValue"
        },
        "failure_mode": {
          "$ref": "#/$defs/FailureModeValue"
        },
        "erodibility": {
          "$ref": "#/$defs/ErodibilityValue"
        }
      },
      "required": [
        "water_volume_above_invert",
        "water_height_above_invert",
        "breach_height",
        "dam_height",
        "average_embankment_width",
        "dam_type",
        "failure_mode",
        "erodibility"
      ],
      "title": "BreachInputs",
      "type": "object"
    },
    "Cascade": {
      "additionalProperties": false,
      "description": "Present only when a site has a dam with `triggered_by` set (`docs/decisions.md` M2\ncascade decision). `approach='two_stage_imposed'` is the only one M2 implements today:\n`dambreak_structure` (dynamic breaching inside a Delft3D structure) belongs to M3, not M2 \u2014\n`backend/m2_breach/cascade.py` raises if it sees that value.",
      "properties": {
        "approach": {
          "enum": [
            "two_stage_imposed",
            "dambreak_structure"
          ],
          "title": "Approach",
          "type": "string"
        }
      },
      "required": [
        "approach"
      ],
      "title": "Cascade",
      "type": "object"
    },
    "CascadeTrigger": {
      "additionalProperties": false,
      "description": "When a downstream dam in a cascade fails, under `Cascade.approach ==\n'two_stage_imposed'` (`docs/decisions.md`): the dam's own breach hydrograph is triggered\nonce routed inflow from its upstream dam(s) first reaches `value` (m^3/s). Per-dam, not\nsite-level, because different dams in a chain have different capacities \u2014 this is additive\nto contract \u00a73.1's single site-level `cascade.trigger` and is PENDING team agreement\n(`docs/decisions.md`).",
      "properties": {
        "type": {
          "const": "inflow_threshold",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/DischargeValue"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "CascadeTrigger",
      "type": "object"
    },
    "Crs": {
      "additionalProperties": false,
      "properties": {
        "utm_epsg": {
          "$ref": "#/$defs/EpsgValue"
        }
      },
      "required": [
        "utm_epsg"
      ],
      "title": "Crs",
      "type": "object"
    },
    "CurveValue": {
      "additionalProperties": false,
      "description": "A surveyed elevation-volume curve: [[elevation_m, volume_m3], ...].",
      "properties": {
        "value": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "const": "m^3",
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "sourced",
            "placeholder"
          ],
          "title": "Status",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "value",
        "unit",
        "source",
        "status"
      ],
      "title": "CurveValue",
      "type": "object"
    },
    "Dam": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "moraine_dammed_lake",
            "embankment_dam",
            "concrete_dam",
            "landslide_dam"
          ],
          "title": "Kind",
          "type": "string"
        },
        "triggered_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Triggered By"
        },
        "trigger": {
          "anyOf": [
            {
              "$ref": "#/$defs/CascadeTrigger"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "equations_applicable": {
          "default": true,
          "title": "Equations Applicable",
          "type": "boolean"
        },
        "imposed_ranges": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImposedRanges"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "location": {
          "$ref": "#/$defs/PointValue"
        },
        "breach_location": {
          "$ref": "#/$defs/PointValue"
        },
        "breach_inputs": {
          "$ref": "#/$defs/BreachInputs"
        },
        "volume_elevation": {
          "anyOf": [
            {
              "$ref": "#/$defs/VolumeElevation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "breach_hydrograph": {
          "anyOf": [
            {
              "$ref": "#/$defs/BreachHydrographSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "initial_water_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/LengthValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "location",
        "breach_location",
        "breach_inputs"
      ],
      "title": "Dam",
      "type": "object"
    },
    "DamTypeValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "enum": [
                "HD",
                "CD",
                "FD",
                "ZD"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "const": "enum",
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "sourced",
            "placeholder"
          ],
          "title": "Status",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "value",
        "unit",
        "source",
        "status"
      ],
      "title": "DamTypeValue",
      "type": "object"
    },
    "DateTimeValue": {
      "additionalProperties": false,
      "description": "ISO 8601 date or datetime, kept as the original string.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "const": "iso8601",
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "sourced",
            "placeholder"
          ],
          "title": "Status",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "value",
        "unit",
        "source",
        "status"
      ],
      "title": "DateTimeValue",
      "type": "object"
    },
    "DimensionlessValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "const": "-",
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "sourced",
            "placeholder"
          ],
          "title": "Status",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "value",
        "unit",
        "source",
        "status"
      ],
      "title": "DimensionlessValue",
      "type": "object"
    },
    "DischargeRangeValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "const": "m^3/s",
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "sourced",
            "placeholder"
          ],
          "title": "Status",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "value",
        "unit",
        "source",
        "status"
      ],
      "title": "DischargeRangeValue",
      "type": "object"
    },
    "DischargeValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "const": "m^3/s",
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "sourced",
            "placeholder"
          ],
          "title": "Status",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "value",
        "unit",
        "source",
        "status"
      ],
      "title": "DischargeValue",
      "type": "object"
    },
    "Domain": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "bbox": {
          "$ref": "#/$defs/BBoxValue"
        },
        "grid_resolution": {
          "$ref": "#/$defs/LengthValue"
        },
        "inflow": {
          "$ref": "#/$defs/Inflow"
        }
      },
      "required": [
        "bbox",
        "grid_resolution",
        "inflow"
      ],
      "title": "Domain",
      "type": "object"
    },
    "Domains": {
      "additionalProperties": false,
      "properties": {
        "far_field": {
          "$ref": "#/$defs/Domain"
        },
        "near_field": {
          "$ref": "#/$defs/Domain"
        }
      },
      "required": [
        "far_field",
        "near_field"
      ],
      "title": "Domains",
      "type": "object"
    },
    "EmulatorInput": {
      "additionalProperties": false,
      "description": "Contract \u00a73.3 `emulator_inputs` entry. Feature 4 uses only `water_volume_m3` (F4-D5:\nvolume is sampled only over an explicit range here); the other names are accepted and kept\nfor later features.",
      "properties": {
        "name": {
          "enum": [
            "water_volume_m3",
            "initial_water_level_m",
            "breach_width_m",
            "failure_time_s",
            "manning_multiplier"
          ],
          "title": "Name",
          "type": "string"
        },
        "dam_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dam Id"
        },
        "range": {
          "$ref": "#/$defs/EmulatorInputRange"
        },
        "slider": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmulatorInputSlider"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "default": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        }
      },
      "required": [
        "name",
        "range"
      ],
      "title": "EmulatorInput",
      "type": "object"
    },
    "EmulatorInputRange": {
      "additionalProperties": false,
      "description": "Contract \u00a73.3 `emulator_inputs[].range`. Like every config fact it carries a source and a\nstatus; a range that is not sourced stays `placeholder` and flags results (CLAUDE.md rule 3).",
      "properties": {
        "low": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Low"
        },
        "high": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "High"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "status": {
          "default": "placeholder",
          "enum": [
            "sourced",
            "placeholder"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "low",
        "high",
        "unit",
        "source"
      ],
      "title": "EmulatorInputRange",
      "type": "object"
    },
    "EmulatorInputSlider": {
      "additionalProperties": false,
      "properties": {
        "positions": {
          "items": {
            "type": "integer"
          },
          "title": "Positions",
          "type": "array"
        },
        "mapping": {
          "enum": [
            "linear",
            "log"
          ],
          "title": "Mapping",
          "type": "string"
        }
      },
      "required": [
        "positions",
        "mapping"
      ],
      "title": "EmulatorInputSlider",
      "type": "object"
    },
    "EpsgValue": {
      "additionalProperties": false,
      "description": "A WGS 84 / UTM EPSG code (326nn north, 327nn south).",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "const": "epsg",
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "sourced",
            "placeholder"
          ],
          "title": "Status",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "value",
        "unit",
        "source",
        "status"
      ],
      "title": "EpsgValue",
      "type": "object"
    },
    "ErodibilityValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "enum": [
                "H",
                "M",
                "L"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "const": "enum",
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "sourced",
            "placeholder"
          ],
          "title": "Status",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "value",
        "unit",
        "source",
        "status"
      ],
      "title": "ErodibilityValue",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "historical",
            "hypothetical"
          ],
          "title": "Kind",
          "type": "string"
        },
        "onset": {
          "$ref": "#/$defs/DateTimeValue"
        },
        "breach_times": {
          "additionalProperties": {
            "$ref": "#/$defs/DateTimeValue"
          },
          "title": "Breach Times",
          "type": "object"
        },
        "simulation_start": {
          "$ref": "#/$defs/DateTimeValue"
        },
        "simulation_end": {
          "$ref": "#/$defs/DateTimeValue"
        },
        "imagery_pre_event": {
          "$ref": "#/$defs/DateTimeValue"
        },
        "imagery_post_event": {
          "$ref": "#/$defs/DateTimeValue"
        }
      },
      "required": [
        "id",
        "name",
