          "anyOf": [
            {
              "enum": [
                "O",
                "P"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "const": "enum",
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "sourced",
            "placeholder"
          ],
          "title": "Status",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
