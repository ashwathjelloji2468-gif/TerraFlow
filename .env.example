# SIH26 GLOF / dam-break decision-support tool — environment variables.
#
# Copy this file to `.env` in the repo root (`.env` is gitignored, CLAUDE.md rule 12: secrets
# never committed) and fill in only what you need for the module you're running. Everything here
# is optional for the mocked API/frontend demo (`backend/m0_api` serves `contracts/examples/`
# unless a module explicitly reads real data). `.env` is a plain KEY=VALUE file with no quoting
# needed; a value with no real key is fine to leave blank.

# --- backend/m1_terrain: DEM download (OpenTopography Global DEM API) ------------------------
# Free key from https://portal.opentopography.org/myopentopo (sign up, "My Account" -> API key).
# Used by backend/m1_terrain/download.py to fetch SRTM GL1 / Copernicus GLO-30 DEM candidates
# for the M1-2 DEM comparison report (docs/data_sources.md src_035).
OPENTOPOGRAPHY_API_KEY=

# --- backend/m1_terrain/hydrobasins.py: HydroBASINS (Feature 2) ------------------------------
# Folder holding the HydroSHEDS standard shapefiles hybas_<region>_lev12_v1c.shp (download once,
# no key, from https://www.hydrosheds.org/products/hydrobasins). Optional: without it (and without
# Earth Engine credentials) the catchment is recorded as unavailable.
# HYDROBASINS_DIR=

# --- backend/m1_terrain/ingest.py: network switch (Feature 2) ----------------------------------
# off = never contact a data service; every product that needs the network is recorded
# "unavailable" with this reason (the test suite sets it). Default on.
# SIH26_INGEST_NETWORK=on

# --- backend/m7_gee: Google Earth Engine (lake area, rainfall, event imagery) ------------------
# Two auth paths; you only need one:
#
# 1) Personal OAuth (what the demo machine actually uses today, docs/progress.md 2026-09-28):
#    run `earthengine authenticate` once in this environment's Python/conda env, then only
#    GEE_PROJECT below is required (no service-account variables needed).
#
# 2) Service account (for a headless/CI environment): a GCP service account with Earth Engine
#    access, and the *path* to its downloaded JSON key file (never the key contents — CLAUDE.md
#    rule 12, backend/m7_gee/scene_search.py only ever reads the path).
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY_PATH=

# Earth Engine Cloud project registered for EE access. Required either way — modern EE accounts
# have no server-side default project (backend/m7_gee/scene_search.py `_ee_initialize`).
GEE_PROJECT=

# --- backend/m0_api: data directory override ---------------------------------------------------
# Where run/scenario/job data lives (contract §1.8). Defaults to <repo>/data if unset.
# SIH26_DATA_DIR=

# --- backend/m3_dflowfm: D-Flow FM kernel location ----------------------------------------------
# Path to run_dflowfm.sh from a local Delft3D FM install (docs/dflowfm_kernel_build.md). Not
# checked into this repo. Defaults to ~/delft3d/dflowfm-2026.01/lnx64/bin/run_dflowfm.sh if unset.
# SIH26_DFLOWFM_KERNEL=

# --- backend/m4_sph: DualSPHysics binaries -------------------------------------------------------
# Directory containing GenCase_linux64 / DualSPHysics5.4_linux64 (DualSPHysics v5.4.3). Not
# checked into this repo. Required for real M4 runs; without it, M4 tests requiring a solver skip.
# DSPH_BIN_DIR=

# --- backend/m0_api/worker.py: fake-stage timing knobs (dev/test only) --------------------------
# Override how long the mocked job stages take and how many fake solver runs a campaign fakes.
# Leave unset for the defaults used by the test suite.
# SIH26_FAKE_STAGE_S=3.0
# SIH26_FAKE_N_RUNS=3
# SIH26_FAKE_RUN_STEPS=5
# SIH26_FAKE_RUN_STEP_S=2.0

# --- frontend: Vite dev server ------------------------------------------------------------------
# Copy these two lines into frontend/.env.local (Vite only reads VITE_-prefixed vars from
# frontend/, not the repo root .env). Defaults shown are what the app falls back to if unset.
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# VITE_USE_MOCKS=false
